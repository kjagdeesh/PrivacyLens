<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PrivacyLens.ViewModels"
             xmlns:converters="clr-namespace:PrivacyLens.Converters"
             xmlns:controls="clr-namespace:PrivacyLens.Controls"
             xmlns:models="clr-namespace:PrivacyLens.Models"
             x:Class="PrivacyLens.Views.HomePage"
             Title="Home"
             x:DataType="vm:HomeViewModel"
             x:Name="HomePageRoot">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:DateTimeToRelativeTimeConverter x:Key="DateTimeToRelativeTimeConverter" />
            <converters:PermissionIconConverter x:Key="PermissionIconConverter" />
            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!-- Main Content -->
        <Grid x:Name="ContentGrid" Opacity="0" RowDefinitions="Auto, *">
            <!-- Top fixed section: Header & Stats -->
            <VerticalStackLayout Grid.Row="0" Spacing="0" Padding="16,50,16,16">

                    <!-- Header with Refresh All Services button -->
                    <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,40">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding Greeting}"
                                   Style="{StaticResource PageTitleStyle}" />
                            <Label Text="Your privacy overview"
                                   Style="{StaticResource PageSubtitleStyle}" />
                        </VerticalStackLayout>

                        <!-- Refresh All Services Button & Timestamp -->
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                            <Border StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="12,8"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray850}}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ForceRefreshCommand}" />
                                </Border.GestureRecognizers>

                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center" HorizontalOptions="Center">
                                    <Image Source="ic_verified_user.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                                    <Label Text="Refresh All"
                                           FontSize="12"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <Label Text="{Binding LastUpdatedText}"
                                   FontSize="10"
                                   HorizontalOptions="End"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Stat cards: unified monochrome, 3 columns -->
                    <Grid IsVisible="{Binding HasStats}"
                          ColumnDefinitions="*,*,*"
                          ColumnSpacing="8"
                          Margin="0,0,0,24">

                        <!-- Apps -->
                        <Frame Grid.Column="0"
                               CornerRadius="12"
                               HasShadow="True"
                               Padding="12,14"
                               BorderColor="Transparent"
                               BackgroundColor="{AppThemeBinding Light=#90CAF9, Dark=#1565C0}">
                            <Frame.Shadow>
                                <Shadow Brush="Black" Opacity="0.15" Offset="0,4" Radius="8" />
                            </Frame.Shadow>
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateToAppsCommand}" />
                                </Grid.GestureRecognizers>
                                <Image Grid.Row="0"
                                       Source="ic_info.png"
                                       WidthRequest="16" HeightRequest="16"
                                       HorizontalOptions="End">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ShowAppsInfoCommand}" />
                                    </Image.GestureRecognizers>
                                </Image>
                                <Image Grid.Row="1"
                                       Source="ic_phone_android.png"
                                       WidthRequest="24" HeightRequest="24"
                                       HorizontalOptions="Start"
                                       InputTransparent="True"
                                       Margin="0,4,0,8" />
                                <Label Grid.Row="2"
                                       Text="{Binding TotalAppsTracked}"
                                       FontSize="26"
                                       FontAttributes="Bold"
                                       InputTransparent="True"
                                       HorizontalOptions="Start"
                                       TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                                <Label Grid.Row="3"
                                       Text="All Apps"
                                       FontSize="11"
                                       InputTransparent="True"
                                       HorizontalOptions="Start"
                                       TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource White}}" />
                            </Grid>
                        </Frame>

                        <!-- Sensitive -->
                        <Frame Grid.Column="1"
                               CornerRadius="12"
                               HasShadow="True"
                               Padding="12,14"
                               BorderColor="Transparent"
                               BackgroundColor="{AppThemeBinding Light=#FFB74D, Dark=#EF6C00}">
                            <Frame.Shadow>
                                <Shadow Brush="Black" Opacity="0.15" Offset="0,4" Radius="8" />
                            </Frame.Shadow>
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateToSensitiveAppsCommand}" />
                                </Grid.GestureRecognizers>
                                <Image Grid.Row="0"
                                       Source="ic_info.png"
                                       WidthRequest="16" HeightRequest="16"
                                       HorizontalOptions="End">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ShowSensitiveInfoCommand}" />
                                    </Image.GestureRecognizers>
                                </Image>
                                <Image Grid.Row="1"
                                       Source="ic_lock_open.png"
                                       WidthRequest="24" HeightRequest="24"
                                       HorizontalOptions="Start"
                                       InputTransparent="True"
                                       Margin="0,4,0,8" />
                                <Label Grid.Row="2"
                                       Text="{Binding AppsWithSensitiveAccess}"
                                       FontSize="26"
                                       FontAttributes="Bold"
                                       InputTransparent="True"
                                       HorizontalOptions="Start"
                                       TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                                <Label Grid.Row="3"
                                       Text="Sensitive Permission approved"
                                       FontSize="11"
                                       InputTransparent="True"
                                       HorizontalOptions="Start"
                                       TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource White}}" />
                            </Grid>
                        </Frame>

                        <!-- High Risk -->
                        <Frame Grid.Column="2"
                               CornerRadius="12"
                               HasShadow="True"
                               Padding="12,14"
                               BorderColor="Transparent"
                               BackgroundColor="{AppThemeBinding Light=#E57373, Dark=#C62828}">
                            <Frame.Shadow>
                                <Shadow Brush="Black" Opacity="0.15" Offset="0,4" Radius="8" />
                            </Frame.Shadow>
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateToHighRiskAppsCommand}" />
                                </Grid.GestureRecognizers>
                                <Image Grid.Row="0"
                                       Source="ic_info.png"
                                       WidthRequest="16" HeightRequest="16"
                                       HorizontalOptions="End">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ShowHighRiskInfoCommand}" />
                                    </Image.GestureRecognizers>
                                </Image>
                                <Image Grid.Row="1"
                                       Source="ic_warning.png"
                                       WidthRequest="24" HeightRequest="24"
                                       HorizontalOptions="Start"
                                       InputTransparent="True"
                                       Margin="0,4,0,8" />
                                <Label Grid.Row="2"
                                       Text="{Binding HighRiskAppsCount}"
                                       FontSize="26"
                                       FontAttributes="Bold"
                                       InputTransparent="True"
                                       HorizontalOptions="Start"
                                       TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                                <Label Grid.Row="3"
                                       Text="High Risk permision approved"
                                       FontSize="11"
                                       InputTransparent="True"
                                       HorizontalOptions="Start"
                                       TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource White}}" />
                            </Grid>
                        </Frame>
                    </Grid>

                    <!-- Action buttons -->
                    <!--<HorizontalStackLayout HorizontalOptions="Center" Spacing="12" Margin="0,0,0,16">
                        <Button Text="View Apps"
                                Command="{Binding NavigateToAppsCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Text="Permissions"
                                Command="{Binding NavigateToPermissionsCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" />
                    </HorizontalStackLayout>-->

                    <!-- Thin divider before activity section -->
                    <BoxView HeightRequest="1"
                             Margin="0,0,0,16"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray900}}"
                             IsVisible="{Binding IsActivityEmpty, Converter={StaticResource InvertedBoolConverter}}" />

                    <!-- Section label -->
                    <Label Text="Recent Activity"
                           Style="{StaticResource SectionHeaderStyle}"
                           Margin="0,0,0,8"
                           IsVisible="{Binding IsActivityEmpty, Converter={StaticResource InvertedBoolConverter}}" />
        </VerticalStackLayout>

        <!-- Scrollable list section -->
        <Grid Grid.Row="1">
                    <!-- Activity list -->
                    <CollectionView ItemsSource="{Binding TodayUsage}"
                                    SelectionMode="None"
                                    VerticalScrollBarVisibility="Never"
                                    Margin="16,0,16,0"
                                    IsVisible="{Binding IsActivityEmpty, Converter={StaticResource InvertedBoolConverter}}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:PermissionUsageRecord">
                                <Frame Style="{StaticResource CardStyle}" Margin="0,0,0,6" BorderColor="Transparent" Padding="10, 10,10,0">
                                    <Frame.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference HomePageRoot}, Path=BindingContext.NavigateToAppDetailsCommand}" CommandParameter="{Binding .}" />
                                    </Frame.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                                        <!-- App Icon -->
                                        <Border Grid.Column="0"
                                                WidthRequest="28"
                                                HeightRequest="28"
                                                StrokeThickness="0"
                                                BackgroundColor="Transparent"
                                                StrokeShape="RoundRectangle 12"
                                                VerticalOptions="Center">
                                                <!--BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray850}}"-->

                                            <Grid>
                                                <Image Source="ic_phone_android.png"
                                                       WidthRequest="24" HeightRequest="24"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center"
                                                       Opacity="0.35" />
                                                <Image Source="{Binding IconCachePath}"
                                                       Aspect="AspectFill" />
                                            </Grid>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                            <Label Text="{Binding AppName}" Style="{StaticResource ListItemTitleStyle}" />
                                            <!--<Label Text="{Binding PermissionName}" Style="{StaticResource ListItemSubtitleStyle}" />-->
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2"
                                               Text="{Binding AccessTime, Converter={StaticResource DateTimeToRelativeTimeConverter}}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray500}}"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Empty state: no activity -->
                    <VerticalStackLayout IsVisible="{Binding IsActivityEmpty}"
                                        Spacing="12"
                                        Padding="40,20,40,24"
                                        HorizontalOptions="Center">
                        <Image Source="ic_search.png"
                               WidthRequest="40" HeightRequest="40"
                               HorizontalOptions="Center"
                               Opacity="0.3" />
                        <Label Text="No recent activity"
                               FontSize="15"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                        <Label Text="Android restricts access timestamps for third-party apps. Browse Apps and Permissions tabs for details."
                               FontSize="13"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               LineHeight="1.5"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" 
                               IsVisible="{Binding HasUsageAccess}" />
                        
                        <Label Text="Enable Usage Access in Android Settings to allow PrivacyLens to track recent activity."
                               FontSize="13"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               LineHeight="1.5"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                               IsVisible="{Binding HasUsageAccess, Converter={StaticResource InvertedBoolConverter}}" />

                        <Button Text="Enable Usage Access"
                                Command="{Binding RequestUsageAccessCommand}"
                                IsVisible="{Binding HasUsageAccess, Converter={StaticResource InvertedBoolConverter}}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,8,0,0"
                                Padding="16,8"
                                HeightRequest="36"
                                FontSize="13" />
                    </VerticalStackLayout>

        </Grid>
        </Grid>

        <!-- ══ Info Bottom Sheet ══════════════════════════════════════════════ -->
        <Grid x:Name="BottomSheetGrid" IsVisible="False" InputTransparent="True" Grid.RowSpan="2">
            <BoxView x:Name="BottomSheetBackdrop" BackgroundColor="#80000000" Opacity="0">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseInfoCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border x:Name="BottomSheetContent"
                    VerticalOptions="End"
                    TranslationY="1000"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 24,24,0,0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}">
                <!-- Prevent taps inside the popup from closing it, but allow swipe down to close -->
                <Border.GestureRecognizers>
                    <TapGestureRecognizer />
                    <SwipeGestureRecognizer Direction="Down" Command="{Binding CloseInfoCommand}" />
                </Border.GestureRecognizers>
                
                <VerticalStackLayout Padding="24,16,24,0" Spacing="20">
                    <!-- Drag handle -->
                    <BoxView WidthRequest="40" HeightRequest="4" CornerRadius="2"
                             HorizontalOptions="Center"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray700}}" />

                    <!-- Icon + title -->
                    <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                        <Border WidthRequest="44" HeightRequest="44"
                                StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray850}}"
                                StrokeShape="RoundRectangle 10">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding InfoType}" Value="Apps">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#90CAF9, Dark=#1565C0}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding InfoType}" Value="Sensitive">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFB74D, Dark=#EF6C00}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding InfoType}" Value="HighRisk">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E57373, Dark=#C62828}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Image Source="{Binding InfoEmoji}"
                                   WidthRequest="22" HeightRequest="22"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>
                        <Label Text="{Binding InfoTitle}"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                    </HorizontalStackLayout>

                    <!-- Divider -->
                    <BoxView HeightRequest="1"
                             BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray800}}" />

                    <!-- Description -->
                    <Label Text="{Binding InfoDescription}"
                           FontSize="14"
                           LineHeight="1.6"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />

                    <!-- Dismiss -->
                    <Button Text="Got it"
                            Command="{Binding CloseInfoCommand}"
                            HorizontalOptions="Fill"
                            HeightRequest="48"
                            Margin="0,20,0,0"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- Full-Screen Lottie Loading & Interaction Blocking Overlay -->
        <controls:LoadingOverlayView Grid.RowSpan="2" IsLoading="{Binding IsBusy}" LoadingMessage="Updating privacy dashboard..." />

    </Grid>
</ContentPage>
