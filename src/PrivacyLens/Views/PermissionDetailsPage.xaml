<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PrivacyLens.ViewModels"
             xmlns:converters="clr-namespace:PrivacyLens.Converters"
             xmlns:controls="clr-namespace:PrivacyLens.Controls"
             xmlns:models="clr-namespace:PrivacyLens.Models"
             x:Class="PrivacyLens.Views.PermissionDetailsPage"
             Title="Permission Details"
             x:Name="PermissionDetailsRoot"
             Shell.NavBarIsVisible="False"
             x:DataType="vm:PermissionDetailsViewModel">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:DateTimeToRelativeTimeConverter x:Key="DateTimeToRelativeTimeConverter" />
            <converters:PermissionIconConverter x:Key="PermissionIconConverter" />
            <converters:PermissionStatusConverter x:Key="PermissionStatusConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid x:Name="ContentGrid" Opacity="0" RowDefinitions="Auto, Auto, *" Padding="16, 12, 16, 0">

        <!-- Back button and Page Title -->
        <VerticalStackLayout Grid.Row="0" Spacing="24" Margin="0,10,0,24">
            <Image Source="ic_arrow_back.png" WidthRequest="24" HeightRequest="24" HorizontalOptions="Start">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackButtonClicked" />
                </Image.GestureRecognizers>
            </Image>
            <Label Text="Permission Details" Style="{StaticResource PageTitleStyle}" FontSize="28" FontAttributes="Bold" />
        </VerticalStackLayout>

        <!-- Fixed Header Area -->
        <VerticalStackLayout Grid.Row="1" Spacing="32" Margin="0,0,0,16">
            <!-- Header -->
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="20" Padding="4">
                <!-- Permission icon container (white card) -->
                <Border Grid.Column="0"
                        WidthRequest="56"
                        HeightRequest="56"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray850}}"
                        StrokeShape="RoundRectangle 12"
                        VerticalOptions="Start">
                    <Image Source="{Binding Category, Converter={StaticResource PermissionIconConverter}}"
                           Style="{StaticResource PermissionIconImageStyle}" />
                </Border>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                    <Label Text="{Binding DisplayName}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
                    <Label Text="{Binding GrantedAppCount, StringFormat='{0} applications have access'}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Spacing="4">
                <Label Text="Apps" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
                <Label Text="Applications that have requested or been denied this permission."
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- Scrollable CollectionView -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding AppsWithAccess}"
                        SelectionMode="None"
                        VerticalScrollBarVisibility="Never">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,6" x:DataType="models:PermissionAccessItem">
                        <Border Stroke="{AppThemeBinding Light={StaticResource OutlineVariantLight}, Dark={StaticResource OutlineVariantDark}}"
                                            StrokeThickness="0"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="16,14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference PermissionDetailsRoot}, Path=BindingContext.NavigateToAppDetailsCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="16">
                                <!-- App icon -->
                                <Border Grid.Column="0"
                                                    WidthRequest="38"
                                                    HeightRequest="38"
                                                    StrokeThickness="0"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}"
                                                    StrokeShape="RoundRectangle 12"
                                                    VerticalOptions="Center">
                                    <Grid>
                                        <Image Source="ic_phone_android.png"
                                                           WidthRequest="24" HeightRequest="24"
                                                           HorizontalOptions="Center"
                                                           VerticalOptions="Center"
                                                           Opacity="0.35" />
                                        <Image Source="{Binding IconCachePath}"
                                                           Aspect="AspectFill" />
                                    </Grid>
                                </Border>

                                <!-- App name + status -->
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                    <Label Text="{Binding AppName}" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource OnSurfaceLight}, Dark={StaticResource OnSurfaceDark}}" />
                                    <Border StrokeThickness="0"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                                                        StrokeShape="RoundRectangle 16"
                                                        Padding="12,4"
                                                        HorizontalOptions="Start"
                                                        Margin="0,4,0,0">
                                        <Label Text="{Binding Status}"
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource White}}" />
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Allowed">
                                                <Setter Property="BackgroundColor" Value="#03C03C" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Denied">
                                                <Setter Property="BackgroundColor" Value="#FF1744" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Precise">
                                                <Setter Property="BackgroundColor" Value="#03C03C" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Approximate">
                                                <Setter Property="BackgroundColor" Value="#EDB302" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                    </Border>
                                    <!--<Label Text="{Binding Status}" FontSize="12">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Allowed">
                                                <Setter Property="TextColor" Value="#03C03C" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Denied">
                                                <Setter Property="TextColor" Value="#FF1744" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Precise">
                                                <Setter Property="TextColor" Value="#03C03C" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Approximate">
                                                <Setter Property="TextColor" Value="#EDB302" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>-->
                                </VerticalStackLayout>

                                <!-- Last access -->
                                <Label Grid.Column="2"
                                                   Text="{Binding LastAccessTime, Converter={StaticResource DateTimeToRelativeTimeConverter}}"
                                                   TextTransform="Uppercase"
                                                   FontSize="10"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource OnSurfaceVariantLight}, Dark={StaticResource OnSurfaceVariantDark}}"
                                                   VerticalOptions="Center"
                                                   HorizontalOptions="End" />
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="32" Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                    <Image Source="ic_shield.png"
                                       WidthRequest="48" HeightRequest="48"
                                       HorizontalOptions="Center" />
                    <Label Text="No applications have this permission"
                                       Style="{StaticResource EmptyStateTitleStyle}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Full-Screen Lottie Loading & Interaction Blocking Overlay -->
        <controls:LoadingOverlayView Grid.RowSpan="3" IsLoading="{Binding IsBusy}" LoadingMessage="Loading permission details..." />
        </Grid>
    </Grid>
</ContentPage>
