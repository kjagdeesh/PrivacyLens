<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PrivacyLens.ViewModels"
             xmlns:converters="clr-namespace:PrivacyLens.Converters"
             xmlns:controls="clr-namespace:PrivacyLens.Controls"
             xmlns:models="clr-namespace:PrivacyLens.Models"
             x:Class="PrivacyLens.Views.FilteredAppsPage"
             Title="{Binding PageTitle}"
             x:Name="FilteredAppsRoot"
             Shell.NavBarIsVisible="False"
             x:DataType="vm:FilteredAppsViewModel">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringNotNullOrEmptyConverter x:Key="StringNotNullOrEmptyConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid x:Name="ContentGrid" Opacity="0" RowDefinitions="Auto, Auto, *" Padding="16,12,16,16" RowSpacing="12">
            
            <!-- Back button and Page Title -->
            <VerticalStackLayout Grid.Row="0" Spacing="24" Margin="0,10,0,12">
                <Image Source="ic_arrow_back.png" WidthRequest="24" HeightRequest="24" HorizontalOptions="Start">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackButtonClicked" />
                    </Image.GestureRecognizers>
                </Image>
            </VerticalStackLayout>

            <!-- Description Box -->
            <Border Grid.Row="1"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray900}}"
                    StrokeShape="RoundRectangle 12"
                    Padding="16,14"
                    Margin="0,0,0,8">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsSensitive}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFB74D, Dark=#EF6C00}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{Binding IsHighRisk}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E57373, Dark=#C62828}" />
                    </DataTrigger>
                </Border.Triggers>
                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*">
                    <Image Grid.Row="0" Grid.Column="0"
                           Source="{Binding InfoEmoji}"
                           WidthRequest="24" HeightRequest="24"
                           VerticalOptions="Start"
                           HorizontalOptions="Start"
                           Margin="0,0,12,0" />
                    <Label Grid.Row="0" Grid.Column="1"
                           Text="{Binding PageTitle}"
                           FontSize="16"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsSensitive}" Value="True">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsHighRisk}" Value="True">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding PageDescription}"
                           FontSize="13"
                           Margin="0,12,0,0"
                           TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsSensitive}" Value="True">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource White}}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Label" Binding="{Binding IsHighRisk}" Value="True">
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource White}}" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Grid>
            </Border>

            <!-- App list -->
            <CollectionView Grid.Row="2"
                            ItemsSource="{Binding Apps}"
                            SelectionMode="None"
                            VerticalScrollBarVisibility="Never"
                            HorizontalScrollBarVisibility="Never">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,3" x:DataType="models:InstalledApp">
                            <Border StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}" StrokeShape="RoundRectangle 12" Padding="16,14"> 
                                <!--<Border.Shadow>
                                    <Shadow Brush="Black"
                                            Offset="0,2"
                                            Radius="8"
                                            Opacity="0.1" />
                                </Border.Shadow>-->
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={x:Reference FilteredAppsRoot}, Path=BindingContext.NavigateToAppDetailsCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto, *, Auto"
                                      ColumnSpacing="16">

                                        <!-- App icon container -->
                                        <Border Grid.Column="0"
                                            WidthRequest="34" HeightRequest="34"
                                            VerticalOptions="Start"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10">
                                            <Grid>
                                                <!-- Fallback icon -->
                                                <Image Source="ic_phone_android.png"
                                                   WidthRequest="32" HeightRequest="32"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   Opacity="0.35" />
                                                <!-- Actual cached app icon overlaid -->
                                                <Image Source="{Binding IconCachePath}"
                                                   Aspect="AspectFill" />
                                            </Grid>
                                        </Border>

                                        <!-- Content -->
                                        <VerticalStackLayout Grid.Column="1"
                                                         VerticalOptions="Start"
                                                         Spacing="6">

                                            <!-- App name -->
                                            <Label Text="{Binding Name}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />

                                            <!-- App provided description (only shown if available) -->
                                            <Label Text="{Binding AppProvidedDescription}"
                                               FontSize="13"
                                               LineHeight="1.4"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray200}}"
                                               IsVisible="{Binding AppProvidedDescription, Converter={StaticResource StringNotNullOrEmptyConverter}}" />

                                            <!-- Standard app type description -->
                                            <Label Text="{Binding Description}"
                                               FontSize="13"
                                               LineHeight="1.4"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray400}}" />

                                            <!-- Permission count badge -->
                                            <Border StrokeThickness="0"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}"
                                                StrokeShape="RoundRectangle 16"
                                                Padding="12,4"
                                                HorizontalOptions="Start"
                                                Margin="0,4,0,0">
                                                <Label Text="{Binding GrantedSensitivePermissionCount, StringFormat='{0} permissions'}"
                                                   FontSize="12"
                                                   FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource White}}" />
                                            </Border>
                                        </VerticalStackLayout>

                                        <!-- Trailing chevron -->
                                        <Image Grid.Column="2"
                                           Source="ic_chevron_right.png"
                                           WidthRequest="18" HeightRequest="18"
                                           VerticalOptions="Start"
                                           Margin="0,4,0,0"
                                           Opacity="0.8" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <!-- Empty state -->
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="32" Spacing="12"
                                         HorizontalOptions="Center" VerticalOptions="Center">
                            <Image Source="ic_info.png"
                               WidthRequest="40" HeightRequest="40"
                               HorizontalOptions="Center"
                               Opacity="0.25" />
                            <Label Text="No apps found"
                               Style="{StaticResource EmptyStateTitleStyle}" />
                            <Label Text="There are no apps matching this filter."
                               Style="{StaticResource EmptyStateDescriptionStyle}" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
        </Grid>
        
        <!-- Full-Screen Lottie Loading & Interaction Blocking Overlay -->
        <controls:LoadingOverlayView Grid.RowSpan="3" IsLoading="{Binding IsBusy}" LoadingMessage="Loading apps..." />
    </Grid>
</ContentPage>
