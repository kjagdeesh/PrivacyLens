<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:PrivacyLens.ViewModels"
             x:Class="PrivacyLens.Views.AboutPage"
             Title="About"
             x:Name="AboutRoot"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#FFFFFF"
             x:DataType="vm:AboutViewModel">

    <Grid x:Name="ContentGrid" Opacity="0" Padding="24" RowDefinitions="Auto, *, Auto">
        
        <!-- Middle Section: Logo, App Info, and Policy Links -->
        <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never">

            <VerticalStackLayout Spacing="32">

                <!-- Top Section: Title -->
                <VerticalStackLayout Grid.Row="0" HorizontalOptions="Start" Spacing="4" Margin="0,30,0,0">
                    <Label Text="About" Style="{StaticResource PageTitleStyle}" FontSize="28" FontAttributes="Bold"  />
                    <BoxView HeightRequest="3" WidthRequest="40" Color="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" HorizontalOptions="Start" />
                </VerticalStackLayout>

                <!-- Logo and Name -->
                <VerticalStackLayout HorizontalOptions="Center" Spacing="16">
                    <Border WidthRequest="80" 
                            HeightRequest="80"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 16"
                            HorizontalOptions="Center">
                        <Image Source="nav_about.png" 
                               WidthRequest="80" 
                               HeightRequest="80"
                               HorizontalOptions="Center" 
                               VerticalOptions="Center" />
                    </Border>
                    
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Privacy Lens" 
                               FontSize="22" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" />

                        <Label Text="{Binding AppVersion}" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />

                        <Label Text="Your device. Your data. Your privacy" 
                               FontSize="12" 
                               FontAttributes="Bold" 
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Description Card -->
                <Border Stroke="#E0E0E0" 
                        StrokeThickness="1" 
                        BackgroundColor="#FFFFFF"
                        StrokeShape="RoundRectangle 4"
                        Padding="20">
                    <Label Text="Privacy Lens gives you a clear view of how apps on your device interact with sensitive permissions. Review access to your camera, microphone, location, contacts, photos, and other device features—all from one simple dashboard. Understand your app permissions, review recent activity when available, and make informed decisions about your privacy. &#10;Your device. Your data. Your privacy."
                           FontSize="14" 
                           LineHeight="1.5"
                           TextColor="#333333" />
                </Border>

                <!-- Links Section -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="INFORMATION" 
                           FontSize="12" 
                           FontAttributes="Bold" 
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}"
                           Margin="0,0,0,4" />

                    <!-- Privacy Policy -->
                    <Border Stroke="#E0E0E0" 
                            StrokeThickness="1" 
                            BackgroundColor="#FFFFFF"
                            StrokeShape="RoundRectangle 4"
                            Padding="16">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenPrivacyPolicyCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="16" VerticalOptions="Center">
                            <Image Grid.Column="0" Source="ic_policy.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Privacy Policy" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" VerticalOptions="Center" />
                            <Image Grid.Column="2" Source="ic_chevron_right.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" Opacity="1" />
                        </Grid>
                    </Border>

                    <!-- Terms of Conditions -->
                    <Border Stroke="#E0E0E0" 
                            StrokeThickness="1" 
                            BackgroundColor="#FFFFFF"
                            StrokeShape="RoundRectangle 4"
                            Padding="16">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenTermsCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="16" VerticalOptions="Center">
                            <Image Grid.Column="0" Source="ic_terms.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Terms of Conditions" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" VerticalOptions="Center" />
                            <Image Grid.Column="2" Source="ic_chevron_right.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" Opacity="1" />
                        </Grid>
                    </Border>
                    
                    <!-- GitHub Repo -->
                    <Border Stroke="#E0E0E0" 
                            StrokeThickness="1" 
                            BackgroundColor="#FFFFFF"
                            StrokeShape="RoundRectangle 4"
                            Padding="16">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenGithubCommand}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="16" VerticalOptions="Center">
                            <Image Grid.Column="0" Source="github.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Source Code (GitHub)" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource TextPrimaryDark}}" VerticalOptions="Center" />
                            <Image Grid.Column="2" Source="ic_chevron_right.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" Opacity="1" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
        
        <!-- Bottom Section: Footer -->
        <VerticalStackLayout Grid.Row="2" Spacing="16" Margin="0,16,0,0" HorizontalOptions="Center" VerticalOptions="End">
            <BoxView HeightRequest="1" WidthRequest="40" Color="#E0E0E0" HorizontalOptions="Center" />
            <Label Text="© 2026 Privacy Lens Project. All rights reserved." 
                   FontSize="11" 
                   TextColor="#888888" 
                   HorizontalOptions="Center" />
        </VerticalStackLayout>
        
    </Grid>
</ContentPage>
