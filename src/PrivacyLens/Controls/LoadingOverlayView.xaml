<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI.Maui"
             x:Class="PrivacyLens.Controls.LoadingOverlayView"
             IsVisible="False"
             Opacity="0"
             InputTransparent="False"
             ZIndex="999">

    <!-- Full Screen Black Semi-Transparent Background (Dark Alpha Overlay) -->
    <Grid BackgroundColor="#D9000000"
          HorizontalOptions="Fill"
          VerticalOptions="Fill"
          Margin="0"
          Padding="0">

        <VerticalStackLayout Spacing="18" HorizontalOptions="Center" VerticalOptions="Center">

            <!-- Animated Lottie Loader from Resources/Raw/loading.json -->
            <skia:SKLottieView x:Name="LottieAnimation"
                               RepeatCount="-1"
                               RepeatMode="Restart"
                               IsAnimationEnabled="True"
                               HeightRequest="140"
                               WidthRequest="140"
                               HorizontalOptions="Center"
                               VerticalOptions="Center">
                <skia:SKLottieView.Source>
                    <skia:SKFileLottieImageSource File="loading.json" />
                </skia:SKLottieView.Source>
            </skia:SKLottieView>

            <!-- Friendly White Loading Text -->
            <Label Text="{Binding LoadingMessage, Source={RelativeSource AncestorType={x:Type ContentView}}}"
                   FontSize="16"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   TextColor="#FFFFFF" />

            <Label Text="Please wait a moment"
                   FontSize="13"
                   HorizontalTextAlignment="Center"
                   TextColor="#CCCCCC" />

        </VerticalStackLayout>

    </Grid>

</ContentView>
